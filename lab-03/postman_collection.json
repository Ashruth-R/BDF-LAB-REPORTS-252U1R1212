    {
      "name": "04 - Resource CRUD & Status Codes (201, 200, 404)",
      "item": [
        {
          "name": "POST /books/ - Valid Book Creation (201 Created)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Site Reliability Engineering\",\n  \"author\": \"Betsy Beyer et al.\",\n  \"price\": 850,\n  \"pages\": 550\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Contains bookId and success message', function () {",
                  "    pm.expect(json).to.have.property('bookId');",
                  "    pm.expect(json.message).to.equal('Book created successfully');",
                  "});",
                  "pm.environment.set('createdBookId', json.bookId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/:bookId/ - Retrieve Existing Book (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{createdBookId}}", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Book matches retrieved ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.equal(parseInt(pm.environment.get('createdBookId')));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
