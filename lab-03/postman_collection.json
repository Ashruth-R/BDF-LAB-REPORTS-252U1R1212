    {
      "name": "03 - Request Validation (400 Bad Request)",
      "item": [
        {
          "name": "POST /books/ - Missing Title (Reject with 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Martin Fowler\",\n  \"price\": 780,\n  \"pages\": 400\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
