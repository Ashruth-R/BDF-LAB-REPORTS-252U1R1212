    {
      "name": "02 - Query Parameters & Filtering (GET /books/)",
      "item": [
        {
          "name": "GET /books/ - Default List (limit 10, offset 0, order id ASC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns an array of books up to default limit 10', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(Array.isArray(data)).to.be.true;",
                  "    pm.expect(data.length).to.be.at.most(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/?search_q=JavaScript - Partial Title Match",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=JavaScript",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""],
              "query": [
                { "key": "search_q", "value": "JavaScript" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Every book title matches search query', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    data.forEach(function (b) {",
                  "        pm.expect(b.title.toLowerCase()).to.include('javascript');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/?min_price=500&max_price=800 - Price Range Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?min_price=500&max_price=800",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""],
              "query": [
                { "key": "min_price", "value": "500" },
                { "key": "max_price", "value": "800" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All book prices fall within [500, 800]', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    data.forEach(function (b) {",
                  "        pm.expect(b.price).to.be.at.least(500);",
                  "        pm.expect(b.price).to.be.at.most(800);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/?order_by=price&order=DESC - Sorting",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Prices are descending', function () {",
                  "    var data = pm.response.json();",
                  "    for (var i = 0; i < data.length - 1; i++) {",
                  "        pm.expect(data[i].price).to.be.at.least(data[i + 1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/?limit=3&offset=3 - Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?limit=3&offset=3",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "3" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Exact 3 records returned', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.length).to.equal(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/ - Combined Filters & Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/?search_q=Code&min_price=600&max_price=800&order_by=price&order=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books", ""],
              "query": [
                { "key": "search_q", "value": "Code" },
                { "key": "min_price", "value": "600" },
                { "key": "max_price", "value": "800" },
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Combined criteria verified', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    data.forEach(function (b) {",
                  "        pm.expect(b.title.toLowerCase()).to.include('code');",
                  "        pm.expect(b.price).to.be.at.least(600);",
                  "        pm.expect(b.price).to.be.at.most(800);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
